<Window x:Class="Tfrs.VoiceClient.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Tfrs.VoiceClient.Localization"
        Title="{loc:Loc SettingsTitle}"
        Background="{StaticResource BgBrush}"
        Height="860" Width="440" MinHeight="860" MinWidth="440"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="160" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Devices -->
        <GroupBox Header="{loc:Loc AudioDevicesHeader}" Grid.Row="0" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Content="{loc:Loc MicrophoneLabel}" Grid.Row="0" Grid.Column="0" />
                <ComboBox x:Name="InputDeviceCombo" Grid.Row="0" Grid.Column="1" Margin="6,2" SelectionChanged="InputDeviceCombo_SelectionChanged" />

                <Label Content="{loc:Loc MicrophoneVolumeLabel}" Grid.Row="1" Grid.Column="0" />
                <Slider x:Name="MicVolumeSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="2" Margin="6,4" ValueChanged="MicVolumeSlider_ValueChanged" />

                <Label Content="{loc:Loc MicrophoneLabel}" Grid.Row="2" Grid.Column="0" />
                <ProgressBar x:Name="MicLevelBar" Grid.Row="2" Grid.Column="1" Height="7" Margin="6,4" Minimum="0" Maximum="0.3" />

                <Label Content="{loc:Loc SpeakerHeadsetLabel}" Grid.Row="3" Grid.Column="0" />
                <ComboBox x:Name="OutputDeviceCombo" Grid.Row="3" Grid.Column="1" Margin="6,2" SelectionChanged="OutputDeviceCombo_SelectionChanged" />

                <Label Content="{loc:Loc PlaybackVolumeLabel}" Grid.Row="4" Grid.Column="0" />
                <Slider x:Name="SpeakerVolumeSlider" Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="2" Margin="6,4" ValueChanged="SpeakerVolumeSlider_ValueChanged" />
            </Grid>
        </GroupBox>

        <!-- Transmit mode -->
        <GroupBox Header="{loc:Loc TransmitModeHeader}" Grid.Row="1" Margin="0,0,0,8">
            <StackPanel>
                <RadioButton x:Name="PttRadio" Content="{loc:Loc PushToTalk}" GroupName="Mode" Checked="TransmitModeRadio_Checked" />
                <RadioButton x:Name="VadRadio" Content="{loc:Loc VoiceActivation}" GroupName="Mode" Checked="TransmitModeRadio_Checked" />
                <RadioButton x:Name="AlwaysOnRadio" Content="{loc:Loc AlwaysOn}" GroupName="Mode" Checked="TransmitModeRadio_Checked" />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Content="{loc:Loc VadSensitivityLabel}" Grid.Column="0" />
                    <Slider x:Name="VadThresholdSlider" Grid.Column="1" Minimum="0.001" Maximum="0.05" Margin="6,4" ValueChanged="VadThresholdSlider_ValueChanged" />
                </Grid>
                <!-- Level meter right next to the threshold it's being compared against, so you
                     can actually see where your voice sits while dragging the slider. -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Content="{loc:Loc MicrophoneLabel}" Grid.Column="0" />
                    <ProgressBar x:Name="VadLevelBar" Grid.Column="1" Height="7" Margin="6,4" Minimum="0" Maximum="0.3" />
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- Hotkeys -->
        <GroupBox Header="{loc:Loc KeysHeader}" Grid.Row="2" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Content="{loc:Loc PushToTalk}" Grid.Row="0" Grid.Column="0" />
                <Button x:Name="PttBindButton" Content="{loc:Loc NotBound}" Grid.Row="0" Grid.Column="1" Margin="6,2" Click="PttBindButton_Click" />

                <Label Content="{loc:Loc MicMuteLabel}" Grid.Row="1" Grid.Column="0" />
                <Button x:Name="MicMuteBindButton" Content="{loc:Loc NotBound}" Grid.Row="1" Grid.Column="1" Margin="6,2" Click="MicMuteBindButton_Click" />

                <Label Content="{loc:Loc SpeakerMuteLabel}" Grid.Row="2" Grid.Column="0" />
                <Button x:Name="SpeakerMuteBindButton" Content="{loc:Loc NotBound}" Grid.Row="2" Grid.Column="1" Margin="6,2" Click="SpeakerMuteBindButton_Click" />
            </Grid>
        </GroupBox>

        <TextBlock Text="{loc:Loc LogHeader}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Grid.Row="3" Margin="2,0,0,4" />
        <ListBox x:Name="LogListBox" Grid.Row="4" Margin="0,0,0,10" />

        <Button x:Name="CloseButton" Content="{loc:Loc CloseButton}" Grid.Row="5" Width="120" HorizontalAlignment="Right" Click="CloseButton_Click" />
    </Grid>
</Window>
