<Window x:Class="Tfrs.VoiceClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Force Radio Standalone"
        Height="720" Width="460" MinHeight="520" MinWidth="400"
        ResizeMode="CanResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">

            <TextBlock Text="TASK FORCE RADIO STANDALONE" FontWeight="Bold" FontSize="15"
                       Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4" />
            <TextBlock Text="Voice Client" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16" />

            <!-- Connection -->
            <GroupBox x:Name="ServerGroupBox" Header="SERVER" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label Content="IP / Host" Grid.Row="0" Grid.Column="0" />
                    <TextBox x:Name="HostTextBox" Grid.Row="0" Grid.Column="1" Margin="6,3" />
                    <Label Content="Port" Grid.Row="0" Grid.Column="2" Margin="10,0,0,0" />
                    <TextBox x:Name="PortTextBox" Grid.Row="0" Grid.Column="3" Margin="6,3" Text="9987" />

                    <Label Content="Passwort" Grid.Row="1" Grid.Column="0" />
                    <PasswordBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="6,3" />
                </Grid>
            </GroupBox>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ConnectButton" Content="Verbinden" Width="110" Style="{StaticResource AccentButton}" Click="ConnectButton_Click" Grid.Column="0" />
                <Button x:Name="DisconnectButton" Content="Trennen" Width="110" Margin="8,0,0,0" IsEnabled="False" Click="DisconnectButton_Click" Grid.Column="1" />
                <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="Nicht verbunden" FontWeight="SemiBold" />
                    <TextBlock x:Name="RosterCountText" Text="" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                </StackPanel>
            </Grid>

            <!-- Devices -->
            <GroupBox Header="AUDIOGERÄTE" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label Content="Mikrofon" Grid.Row="0" Grid.Column="0" />
                    <ComboBox x:Name="InputDeviceCombo" Grid.Row="0" Grid.Column="1" Margin="6,3" SelectionChanged="InputDeviceCombo_SelectionChanged" />

                    <Label Content="Mikrofon-Lautstärke" Grid.Row="1" Grid.Column="0" />
                    <Slider x:Name="MicVolumeSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="2" Margin="6,8" ValueChanged="MicVolumeSlider_ValueChanged" />

                    <!-- Always visible — not tucked away in the transmit-mode section — so you can
                         see it's picking up your voice regardless of PTT/VAD/always-on. -->
                    <Label Content="Mikrofonpegel" Grid.Row="2" Grid.Column="0" />
                    <ProgressBar x:Name="MicLevelBar" Grid.Row="2" Grid.Column="1" Height="8" Margin="6,3" Minimum="0" Maximum="0.3" />

                    <Label Content="Lautsprecher/Headset" Grid.Row="3" Grid.Column="0" />
                    <ComboBox x:Name="OutputDeviceCombo" Grid.Row="3" Grid.Column="1" Margin="6,3" SelectionChanged="OutputDeviceCombo_SelectionChanged" />

                    <Label Content="Wiedergabe-Lautstärke" Grid.Row="4" Grid.Column="0" />
                    <Slider x:Name="SpeakerVolumeSlider" Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="2" Margin="6,8" ValueChanged="SpeakerVolumeSlider_ValueChanged" />

                    <Label Content="Eingehender Pegel" Grid.Row="5" Grid.Column="0" />
                    <ProgressBar x:Name="SpeakerLevelBar" Grid.Row="5" Grid.Column="1" Height="8" Margin="6,3" Minimum="0" Maximum="0.3"
                                 Foreground="{StaticResource SuccessBrush}" />
                </Grid>
            </GroupBox>

            <!-- Transmit mode -->
            <GroupBox Header="SENDEMODUS" Margin="0,0,0,10">
                <StackPanel>
                    <RadioButton x:Name="PttRadio" Content="Push-to-Talk" GroupName="Mode" Checked="TransmitModeRadio_Checked" />
                    <RadioButton x:Name="VadRadio" Content="Sprachaktivierung" GroupName="Mode" Checked="TransmitModeRadio_Checked" />
                    <RadioButton x:Name="AlwaysOnRadio" Content="Dauersenden" GroupName="Mode" Checked="TransmitModeRadio_Checked" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Content="VAD-Empfindlichkeit" Grid.Column="0" />
                        <Slider x:Name="VadThresholdSlider" Grid.Column="1" Minimum="0.001" Maximum="0.2" Margin="6,8" ValueChanged="VadThresholdSlider_ValueChanged" />
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- Hotkeys / mute -->
            <GroupBox Header="TASTEN" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label Content="Push-to-Talk" Grid.Row="0" Grid.Column="0" />
                    <Button x:Name="PttBindButton" Content="(nicht gebunden)" Grid.Row="0" Grid.Column="1" Width="150" Margin="6,3" Click="PttBindButton_Click" />

                    <Label Content="Mikrofon stumm" Grid.Row="1" Grid.Column="0" />
                    <Button x:Name="MicMuteBindButton" Content="(nicht gebunden)" Grid.Row="1" Grid.Column="1" Width="150" Margin="6,3" Click="MicMuteBindButton_Click" />
                    <ToggleButton x:Name="MicMuteToggle" Content="Mic Mute" Grid.Row="1" Grid.Column="3" Margin="6,3" Click="MicMuteToggle_Click" />

                    <Label Content="Lautsprecher stumm" Grid.Row="2" Grid.Column="0" />
                    <Button x:Name="SpeakerMuteBindButton" Content="(nicht gebunden)" Grid.Row="2" Grid.Column="1" Width="150" Margin="6,3" Click="SpeakerMuteBindButton_Click" />
                    <ToggleButton x:Name="SpeakerMuteToggle" Content="Speaker Mute" Grid.Row="2" Grid.Column="3" Margin="6,3" Click="SpeakerMuteToggle_Click" />
                </Grid>
            </GroupBox>

            <TextBlock Text="PROTOKOLL" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,4,0,6" />
            <ListBox x:Name="LogListBox" Height="120" Margin="0,0,0,10" />

            <TextBlock x:Name="ExtensionStatusText" Text="Arma-Addon: nicht verbunden" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
        </StackPanel>
    </ScrollViewer>
</Window>
