<Window x:Class="Tfrs.VoiceClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Tfrs.VoiceClient.Localization"
        Title="{loc:Loc AppTitle}"
        Background="{StaticResource BgBrush}"
        Height="630" Width="360" MinHeight="630" MinWidth="360"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- MinHeight guards this row's content (mute toggles + Settings button) against being
                 squeezed off-window when the Levels group above grows (SilenceHintText becoming
                 visible adds a wrapped line) — a fixed-size, non-resizable window has nowhere else
                 for that extra height to come from. -->
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Loc AppTitle}" FontWeight="Bold" FontSize="14"
                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" Text="{loc:Loc VoiceClientSubtitle}" Foreground="{StaticResource TextSecondaryBrush}"
                   HorizontalAlignment="Center" Margin="0,0,0,18" />

        <!-- Connection -->
        <GroupBox x:Name="ServerGroupBox" Header="{loc:Loc ServerHeader}" Grid.Row="2" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Content="{loc:Loc IpHostLabel}" Grid.Row="0" Grid.Column="0" />
                <TextBox x:Name="HostTextBox" Grid.Row="0" Grid.Column="1" Margin="6,2" />
                <Label Content="{loc:Loc PortLabel}" Grid.Row="0" Grid.Column="2" Margin="8,0,0,0" />
                <TextBox x:Name="PortTextBox" Grid.Row="0" Grid.Column="3" Margin="6,2" Text="9987" />

                <Label Content="{loc:Loc PasswordLabel}" Grid.Row="1" Grid.Column="0" />
                <PasswordBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="6,2" />
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="ConnectButton" Content="{loc:Loc ConnectButton}" Width="120" Style="{StaticResource AccentButton}" Click="ConnectButton_Click" />
                <Button x:Name="DisconnectButton" Content="{loc:Loc DisconnectButton}" Width="120" Margin="8,0,0,0" IsEnabled="False" Click="DisconnectButton_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <TextBlock x:Name="StatusText" Text="{loc:Loc StatusNotConnected}" FontWeight="SemiBold" />
                <TextBlock x:Name="MicMutedBadge" Text="{loc:Loc MicMutedBadge}" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Visibility="Collapsed" />
                <TextBlock x:Name="SpeakerMutedBadge" Text="{loc:Loc SpeakerMutedBadge}" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Visibility="Collapsed" />
            </StackPanel>
            <TextBlock x:Name="RosterCountText" Text="" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Levels -->
        <GroupBox Header="{loc:Loc LevelsHeader}" Grid.Row="4" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Content="{loc:Loc MicrophoneLabel}" Grid.Row="0" Grid.Column="0" />
                <ProgressBar x:Name="MicLevelBar" Grid.Row="0" Grid.Column="1" Height="8" Margin="6,4" Minimum="0" Maximum="0.3" />

                <Label Content="{loc:Loc IncomingLabel}" Grid.Row="1" Grid.Column="0" />
                <ProgressBar x:Name="SpeakerLevelBar" Grid.Row="1" Grid.Column="1" Height="8" Margin="6,4" Minimum="0" Maximum="0.3"
                             Foreground="{StaticResource SuccessBrush}" />

                <TextBlock x:Name="SilenceHintText" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{loc:Loc SilenceHintShort}" Foreground="{StaticResource DangerBrush}"
                           FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
            </Grid>
        </GroupBox>

        <!-- Quick mute -->
        <StackPanel Grid.Row="5" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <ToggleButton x:Name="MicMuteToggle" Content="{loc:Loc MicOn}" Width="150" Padding="10,8" Click="MicMuteToggle_Click" />
                <ToggleButton x:Name="SpeakerMuteToggle" Content="{loc:Loc SpeakerOn}" Width="150" Margin="8,0,0,0" Padding="10,8" Click="SpeakerMuteToggle_Click" />
            </StackPanel>
            <Button x:Name="SettingsButton" Content="{loc:Loc SettingsButton}" Width="150" Margin="0,14,0,0" Click="SettingsButton_Click" />
        </StackPanel>

        <TextBlock x:Name="ExtensionStatusText" Grid.Row="6" Text="{loc:Loc ExtensionNotConnected}"
                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,10,0,0" />
    </Grid>
</Window>
