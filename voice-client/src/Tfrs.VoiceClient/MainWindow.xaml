<Window x:Class="Tfrs.VoiceClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Force Radio Standalone — Voice Client"
        Height="560" Width="420" ResizeMode="CanMinimize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Connection -->
        <GroupBox Header="Server" Grid.Row="0" Margin="0,0,0,8">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="70" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Content="IP / Host" Grid.Row="0" Grid.Column="0" />
                <TextBox x:Name="HostTextBox" Grid.Row="0" Grid.Column="1" Margin="4,2" />
                <Label Content="Port" Grid.Row="0" Grid.Column="2" Margin="8,0,0,0" />
                <TextBox x:Name="PortTextBox" Grid.Row="0" Grid.Column="3" Margin="4,2" Text="9987" />

                <Label Content="Passwort" Grid.Row="1" Grid.Column="0" />
                <PasswordBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="4,2" />
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="ConnectButton" Content="Verbinden" Width="100" Padding="4" Click="ConnectButton_Click" />
            <Button x:Name="DisconnectButton" Content="Trennen" Width="100" Padding="4" Margin="8,0,0,0" IsEnabled="False" Click="DisconnectButton_Click" />
            <TextBlock x:Name="StatusText" Text="Nicht verbunden" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBlock x:Name="RosterCountText" Text="" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.7" />
        </StackPanel>

        <!-- Devices -->
        <GroupBox Header="Audiogeräte" Grid.Row="2" Margin="0,0,0,8">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Content="Mikrofon" Grid.Row="0" Grid.Column="0" />
                <ComboBox x:Name="InputDeviceCombo" Grid.Row="0" Grid.Column="1" Margin="4,2" SelectionChanged="InputDeviceCombo_SelectionChanged" />

                <Label Content="Mikrofon-Lautstärke" Grid.Row="1" Grid.Column="0" />
                <Slider x:Name="MicVolumeSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="2" Margin="4,6" ValueChanged="MicVolumeSlider_ValueChanged" />

                <Label Content="Lautsprecher/Headset" Grid.Row="2" Grid.Column="0" />
                <ComboBox x:Name="OutputDeviceCombo" Grid.Row="2" Grid.Column="1" Margin="4,2" SelectionChanged="OutputDeviceCombo_SelectionChanged" />

                <Label Content="Wiedergabe-Lautstärke" Grid.Row="3" Grid.Column="0" />
                <Slider x:Name="SpeakerVolumeSlider" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="2" Margin="4,6" ValueChanged="SpeakerVolumeSlider_ValueChanged" />
            </Grid>
        </GroupBox>

        <!-- Transmit mode -->
        <GroupBox Header="Sendemodus" Grid.Row="3" Margin="0,0,0,8">
            <StackPanel Margin="6">
                <RadioButton x:Name="PttRadio" Content="Push-to-Talk" GroupName="Mode" Checked="TransmitModeRadio_Checked" />
                <RadioButton x:Name="VadRadio" Content="Sprachaktivierung" GroupName="Mode" Checked="TransmitModeRadio_Checked" />
                <RadioButton x:Name="AlwaysOnRadio" Content="Dauersenden" GroupName="Mode" Checked="TransmitModeRadio_Checked" />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Content="VAD-Empfindlichkeit" Grid.Column="0" />
                    <Slider x:Name="VadThresholdSlider" Grid.Column="1" Minimum="0.001" Maximum="0.2" Margin="4,6" ValueChanged="VadThresholdSlider_ValueChanged" />
                </Grid>
                <ProgressBar x:Name="MicLevelBar" Height="6" Margin="0,6,0,0" Minimum="0" Maximum="0.3" />
            </StackPanel>
        </GroupBox>

        <!-- Hotkeys / mute -->
        <GroupBox Header="Tasten" Grid.Row="4" Margin="0,0,0,8">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Content="Push-to-Talk" Grid.Row="0" Grid.Column="0" />
                <Button x:Name="PttBindButton" Content="(nicht gebunden)" Grid.Row="0" Grid.Column="1" Width="140" Click="PttBindButton_Click" />

                <Label Content="Mikrofon stumm" Grid.Row="1" Grid.Column="0" />
                <Button x:Name="MicMuteBindButton" Content="(nicht gebunden)" Grid.Row="1" Grid.Column="1" Width="140" Click="MicMuteBindButton_Click" />
                <ToggleButton x:Name="MicMuteToggle" Content="Mic Mute" Grid.Row="1" Grid.Column="3" Padding="6,2" Click="MicMuteToggle_Click" />

                <Label Content="Lautsprecher stumm" Grid.Row="2" Grid.Column="0" />
                <Button x:Name="SpeakerMuteBindButton" Content="(nicht gebunden)" Grid.Row="2" Grid.Column="1" Width="140" Click="SpeakerMuteBindButton_Click" />
                <ToggleButton x:Name="SpeakerMuteToggle" Content="Speaker Mute" Grid.Row="2" Grid.Column="3" Padding="6,2" Click="SpeakerMuteToggle_Click" />
            </Grid>
        </GroupBox>

        <ListBox x:Name="LogListBox" Grid.Row="5" Margin="0,0,0,8" />

        <TextBlock x:Name="ExtensionStatusText" Grid.Row="6" Text="Arma-Addon: nicht verbunden" Opacity="0.7" />
    </Grid>
</Window>
