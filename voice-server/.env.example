# Copy to .env and adjust. In Coolify, set these under the service's Environment Variables tab
# instead -- docker-compose.yml reads them via ${VAR:-default} so Coolify can override each one.

TFRS_PORT=9987
TFRS_PASSWORD=changeme
TFRS_MAX_CLIENTS=300
TFRS_TIMEOUT_SECONDS=20

# Testing only: forces every connected client to hear every other client at full volume, ignoring
# the Arma addon's distance/gain logic entirely. Lets you verify raw voice transport (mic ->
# relay -> speaker) without trusting the addon bridge. Server-dictated only, sent to clients via
# ConnectAccept -- there is no client-side way to enable this. Turn off for real play.
TFRS_DEBUG_FORCE_AUDIBLE=false
